"""Helpers ETL gerados pelo Conduto para o projeto {{ project_name }}.

Este módulo lê o .env, o main.yml e os schemas/*.yml e executa as cargas
seguindo as chaves de ``schedule`` de cada tabela:

- ``cron``: frequência do schedule no Dagster (expressão cron)
- ``mode``: ``incremental`` (usa ``incremental_column``) ou ``full`` (recarrega tudo)
- ``incremental_column``: coluna usada como marcador de água (watermark)
- ``full_load``: força uma carga completa mesmo no modo incremental
- ``truncate``: limpa a tabela de destino antes de carregar

Edite à vontade: o restante do pipeline lê este arquivo em tempo de execução.
"""

from __future__ import annotations

import json
import queue
import threading
import time
from pathlib import Path
from typing import Any, Dict, List, Optional, Sequence

import yaml

PROJETO_DIR = Path(__file__).resolve().parent.parent


def ler_env() -> Dict[str, str]:
    """Lê as credenciais do .env do projeto."""
    caminho = PROJETO_DIR / ".env"
    if not caminho.exists():
        raise FileNotFoundError(f".env não encontrado em: {caminho}")
    valores: Dict[str, str] = {}
    for linha in caminho.read_text(encoding="utf-8").splitlines():
        linha = linha.strip()
        if not linha or linha.startswith("#") or "=" not in linha:
            continue
        chave, _, valor = linha.partition("=")
        valores[chave.strip()] = valor.strip()
    return valores


def ler_tabelas() -> List[Dict[str, Any]]:
    """Lê o main.yml e os schemas, devolvendo as tabelas na ordem de dependência."""
    main_path = PROJETO_DIR / "main.yml"
    if not main_path.exists():
        return []
    dados = yaml.safe_load(main_path.read_text(encoding="utf-8")) or {}
    tabelas: List[Dict[str, Any]] = []
    for item in dados.get("tables", []):
        caminho = PROJETO_DIR / item["path"]
        if not caminho.exists():
            continue
        tabela = yaml.safe_load(caminho.read_text(encoding="utf-8")) or {}
        if not tabela.get("table"):
            continue
        tabela["path"] = item["path"]
        tabelas.append(tabela)
    nomes = {t["table"] for t in tabelas}
    for tabela in tabelas:
        tabela["deps"] = [d for d in _dependencias(tabela) if d in nomes]
    return tabelas


def _dependencias(tabela: Dict[str, Any]) -> List[str]:
    """Colunas com FK viram dependências de assets (pais antes de filhos)."""
    deps: List[str] = []
    for coluna in tabela.get("columns", []):
        fk = coluna.get("foreign_key")
        if not fk:
            continue
        ref = fk.split("(", 1)[0].rsplit(".", 1)[-1]
        if ref and ref != tabela["table"] and ref not in deps:
            deps.append(ref)
    return deps


def ler_schedule_geral() -> Dict[str, Any]:
    """Lê o schedule do modelo geral no main.yml."""
    main_path = PROJETO_DIR / "main.yml"
    if not main_path.exists():
        return {}
    dados = yaml.safe_load(main_path.read_text(encoding="utf-8")) or {}
    return dados.get("schedule") or {}


def conectar(tipo: str, host: str, porta: str, banco: str, usuario: str, senha: str):
    """Abre uma conexão com o SGBD informado (postgresql, mysql, sqlserver,
    clickhouse, duckdb ou deltalake)."""
    if tipo == "postgresql":
        import psycopg
        return psycopg.connect(
            host=host, port=int(porta), dbname=banco, user=usuario, password=senha
        )
    if tipo == "mysql":
        import pymysql
        return pymysql.connect(
            host=host, port=int(porta), database=banco, user=usuario, password=senha,
            autocommit=True,
        )
    if tipo == "sqlserver":
        import pyodbc
        return pyodbc.connect(_conn_str_sqlserver(host, porta, banco, usuario, senha))
    if tipo == "clickhouse":
        import clickhouse_connect
        return _ConexaoClickHouse(
            clickhouse_connect.get_client(
                host=host,
                port=int(porta) if porta else 8123,
                username=usuario or "default",
                password=senha or "",
                database=banco or "default",
                connect_timeout=5,
            ),
            banco or "default",
        )
    if tipo == "duckdb":
        import duckdb
        return duckdb.connect(host or banco or ":memory:")
    if tipo == "deltalake":
        return _ConexaoDelta(host, banco, usuario, senha)
    raise ValueError(f"SGBD não suportado: {tipo}")


def _ajustar_statement_timeout(conn, timeout: str, context=None) -> None:
    """Ajusta o statement_timeout da conexão de destino no PostgreSQL.

    Cargas via COPY podem estourar o limite default do servidor (ex.: o
    Supabase usa 10s). O valor vem de ``DB_DESTINO_STATEMENT_TIMEOUT`` no
    .env, em milissegundos (``0`` desativa o limite). Funciona em conexão
    direta ou no session pooler (porta 5432); o transaction pooler (porta
    6543) não permite ``SET`` de sessão.
    """
    if timeout is None:
        return
    try:
        with conn.cursor() as cur:
            cur.execute(f"SET statement_timeout = {int(timeout)}")
    except Exception as erro:
        if context is not None:
            context.log.warning(
                f"Não foi possível ajustar o statement_timeout para {timeout}ms "
                f"(use o session pooler/porta 5432 ou conexão direta): {erro}"
            )


def _conn_str_sqlserver(host: str, porta: str, banco: str, usuario: str, senha: str) -> str:
    import pyodbc
    drivers = [d for d in pyodbc.drivers() if "ODBC Driver" in d]
    if not drivers:
        raise RuntimeError("Nenhum ODBC Driver for SQL Server instalado.")
    driver = next((d for d in drivers if "18" in d), drivers[0])
    driver_braces = "{" + driver + "}"
    return (
        f"DRIVER={driver_braces};SERVER={host},{porta};DATABASE={banco};"
        f"UID={usuario};PWD={senha};TrustServerCertificate=yes"
    )


def _interpolar_clickhouse(sql: str, params: Sequence) -> str:
    """Substitui os placeholders %s por valores escapados (client-side)."""

    def _fmt(valor: Any) -> str:
        if valor is None:
            return "NULL"
        texto = str(valor)
        return "'" + texto.replace("\\", "\\\\").replace("'", "\\'") + "'"

    partes = sql.split("%s")
    if len(partes) != len(params) + 1:
        raise ValueError(
            f"Quantidade de placeholders %s nao bate com os parametros: {sql!r}"
        )
    return partes[0] + "".join(_fmt(p) + resto for p, resto in zip(params, partes[1:]))


class _CursorClickHouse:
    """Cursor DBAPI-like sobre o client HTTP do ClickHouse."""

    def __init__(self, client, banco: str):
        self._client = client
        self._banco = banco
        self._linhas: List[Any] = []
        self._indice = 0
        self._colunas: List[str] = []
        self.arraysize = 1

    def execute(self, sql: str, params: Optional[Sequence] = None) -> None:
        if params:
            sql = _interpolar_clickhouse(sql, params)
        comando = sql.lstrip()
        if comando.upper().startswith(
            ("SELECT", "SHOW", "DESCRIBE", "WITH", "EXISTS", "PRAGMA")
        ):
            resultado = self._client.query(sql)
            self._colunas = list(resultado.column_names)
            self._linhas = list(resultado.result_rows)
        else:
            self._client.command(sql)
            self._colunas = []
            self._linhas = []
        self._indice = 0

    @property
    def description(self):
        return [(c, None, None, None, None, None, None) for c in self._colunas]

    def fetchmany(self, size: Optional[int] = None):
        n = size or self.arraysize or 1
        bloco = self._linhas[self._indice : self._indice + n]
        self._indice += len(bloco)
        return bloco

    def fetchone(self):
        bloco = self.fetchmany(1)
        return bloco[0] if bloco else None

    def close(self) -> None:
        pass

    def __enter__(self):
        return self

    def __exit__(self, *exc) -> None:
        self.close()


class _ConexaoClickHouse:
    """Conexao ClickHouse que expoe o minimo de DBAPI usado pelo pipeline."""

    def __init__(self, client, banco: str):
        self._client = client
        self._banco = banco

    def cursor(self):
        return _CursorClickHouse(self._client, self._banco)

    def commit(self) -> None:
        pass

    def close(self) -> None:
        try:
            self._client.close()
        except Exception:
            pass

    def __enter__(self):
        return self

    def __exit__(self, *exc) -> None:
        self.close()


class _ConexaoDelta:
    """Conexao logica para Delta Lake (nao ha sessao, apenas configuracao)."""

    def __init__(self, host: str, banco: str, usuario: str, senha: str):
        self.host = host
        self.banco = banco
        self.usuario = usuario
        self.senha = senha

    @property
    def storage_options(self) -> Optional[Dict[str, str]]:
        if not (self.host or "").startswith(("s3://", "http://", "https://")):
            return None
        opcoes = {
            "AWS_ACCESS_KEY_ID": self.usuario or "",
            "AWS_SECRET_ACCESS_KEY": self.senha or "",
            "AWS_REGION": "us-east-1",
            "AWS_ALLOW_HTTP": "true",
            "AWS_S3_ALLOW_UNSAFE_RENAME": "true",
        }
        if self.host.startswith("http"):
            opcoes["AWS_ENDPOINT_URL"] = self.host
        return opcoes

    @property
    def base(self) -> str:
        """Caminho base (warehouse) das tabelas Delta."""
        host = (self.host or "").strip()
        if not host:
            raise ValueError("HOST do Delta Lake nao informado.")
        if host.startswith("s3://"):
            return host.rstrip("/")
        if host.startswith(("http://", "https://")):
            return f"s3://{(self.banco or 'deltalake').strip()}"
        banco = (self.banco or "").strip()
        if banco and banco != "." and banco != Path(host).name:
            return str(Path(host) / banco)
        return host

    def cursor(self):
        raise NotImplementedError(
            "Delta Lake nao usa cursor: leitura/escrita via helpers especificos."
        )

    def commit(self) -> None:
        pass

    def close(self) -> None:
        pass

    def __enter__(self):
        return self

    def __exit__(self, *exc) -> None:
        self.close()


def _aspas(tipo: str, nome: str) -> str:
    if tipo == "sqlserver":
        return f"[{nome}]"
    if tipo in ("mysql", "clickhouse"):
        return f"`{nome}`"
    return f'"{nome}"'


def _qualificado(tipo: str, schema: str, tabela: str) -> str:
    if tipo == "deltalake":
        return tabela
    return f"{_aspas(tipo, schema)}.{_aspas(tipo, tabela)}"


def _placeholder(tipo: str) -> str:
    return "?" if tipo in ("sqlserver", "duckdb") else "%s"


def _sql_amostra(tipo: str, origem: str) -> str:
    """SELECT que não retorna linhas, usado apenas para descobrir as colunas."""
    if tipo == "sqlserver":
        return f"SELECT TOP (0) * FROM {origem}"
    return f"SELECT * FROM {origem} LIMIT 0"


def _colunas_origem(conn, tipo: str, origem: str) -> List[str]:
    if tipo == "deltalake":
        from deltalake import DeltaTable
        tabela = DeltaTable(
            f"{conn.base}/{origem}",
            storage_options=conn.storage_options or None,
        )
        return [campo.name for campo in tabela.schema().fields]
    with conn.cursor() as cur:
        cur.execute(_sql_amostra(tipo, origem))
        return [descricao[0] for descricao in cur.description]


def _executar(conn, sql: str, params: Optional[Sequence] = None) -> None:
    with conn.cursor() as cur:
        cur.execute(sql, params or ())
    conn.commit()


_FIM = object()
_LOTE = 2000


def _produtor(conn, sql: str, params: Optional[Sequence], fila, lote: int = _LOTE) -> None:
    """Le as linhas da origem em lotes e coloca na fila para o consumidor gravar."""
    try:
        with conn.cursor() as cur:
            cur.arraysize = lote
            cur.execute(sql, params or ())
            colunas = [descricao[0] for descricao in cur.description]
            fila.put(colunas)
            while True:
                bloco = cur.fetchmany(lote)
                if not bloco:
                    break
                fila.put(bloco)
    except Exception as erro:
        fila.put(erro)
    finally:
        fila.put(_FIM)


def _produtor_delta(conn, tabela_nome: str, fila, lote: int = _LOTE) -> None:
    """Le as linhas de uma tabela Delta (origem) em lotes e coloca na fila."""
    try:
        from deltalake import DeltaTable
        caminho = f"{conn.base}/{tabela_nome}"
        tabela_delta = DeltaTable(
            caminho,
            storage_options=conn.storage_options or None,
        )
        colunas = [campo.name for campo in tabela_delta.schema().fields]
        fila.put(colunas)
        for bloco in tabela_delta.to_pyarrow_table().to_batches(max_chunksize=lote):
            fila.put([list(linha.values()) for linha in bloco.to_pylist()])
    except Exception as erro:
        fila.put(erro)
    finally:
        fila.put(_FIM)


def _ultimo_valor(conn, tipo: str, destino: str, coluna: str):
    """Lê o último watermark gravado no destino (None se a tabela não existir)."""
    if tipo == "deltalake":
        try:
            from deltalake import DeltaTable
            tabela = DeltaTable(
                f"{conn.base}/{destino}",
                storage_options=conn.storage_options or None,
            )
            valores = tabela.to_pyarrow_table().column(coluna).to_pylist()
            return max((v for v in valores if v is not None), default=None)
        except Exception:
            return None
    sql = f"SELECT MAX({_aspas(tipo, coluna)}) FROM {destino}"
    try:
        with conn.cursor() as cur:
            cur.execute(sql)
            linha = cur.fetchone()
            return linha[0] if linha else None
    except Exception:
        return None


def _truncar(conn, tipo: str, destino: str) -> None:
    """Limpa a tabela de destino (TRUNCATE com fallback para DELETE)."""
    if tipo == "deltalake":
        try:
            from deltalake import DeltaTable
            tabela = DeltaTable(
                f"{conn.base}/{destino}",
                storage_options=conn.storage_options or None,
            )
            tabela.delete("1 = 1")
        except Exception:
            pass
        return
    try:
        _executar(conn, f"TRUNCATE TABLE {destino}")
    except Exception:
        _executar(conn, f"DELETE FROM {destino}")


def _sanitizar(valor: Any) -> Any:
    """Remove bytes NUL (0x00) de strings (PostgreSQL rejeita NUL em campos text)."""
    if isinstance(valor, str):
        return valor.replace("\x00", "") if "\x00" in valor else valor
    if isinstance(valor, dict):
        return {chave: _sanitizar(item) for chave, item in valor.items()}
    if isinstance(valor, list):
        return [_sanitizar(item) for item in valor]
    return valor


def _serializar(valor: Any) -> Any:
    """Converte dicts/listas para JSON antes de gravar no banco."""
    if isinstance(valor, (dict, list)):
        return json.dumps(_sanitizar(valor), ensure_ascii=False)
    if isinstance(valor, str) and "\x00" in valor:
        return valor.replace("\x00", "")
    return valor


def _copiar(conn, tipo: str, destino: str, fila, context=None) -> int:
    """Consome a fila de lotes da origem e grava no destino.

    No PostgreSQL usa COPY FROM STDIN; no ClickHouse usa o INSERT nativo em
    lote; no Delta Lake usa write_deltalake; nos demais, INSERT em lote.
    """
    if tipo == "clickhouse":
        return _copiar_clickhouse(conn, destino, fila, context)
    if tipo == "deltalake":
        return _copiar_delta(conn, destino, fila, context)
    primeiro = fila.get()
    if isinstance(primeiro, Exception):
        raise primeiro
    colunas = primeiro
    if not colunas:
        return 0
    cols_sql = ", ".join(_aspas(tipo, c) for c in colunas)
    total = 0
    with conn.cursor() as cur:
        if tipo == "postgresql":
            sql = f"COPY {destino} ({cols_sql}) FROM STDIN"
            with cur.copy(sql) as copy:
                while True:
                    item = fila.get()
                    if item is _FIM:
                        break
                    if isinstance(item, Exception):
                        raise item
                    for linha in item:
                        copy.write_row([_serializar(v) for v in linha])
                        total += 1
                    if context is not None and total % 20000 == 0:
                        context.log.info(f"Copiadas {total} linha(s) para {destino}.")
        else:
            ph = ", ".join(_placeholder(tipo) for _ in colunas)
            sql = f"INSERT INTO {destino} ({cols_sql}) VALUES ({ph})"
            rapido = tipo == "sqlserver"
            if rapido:
                # fast_executemany envia o lote como operacao em massa (TVP)
                # em vez de 1 round trip por linha, muito mais rapido no pyodbc.
                cur.fast_executemany = True
            while True:
                item = fila.get()
                if item is _FIM:
                    break
                if isinstance(item, Exception):
                    raise item
                valores = [tuple(_serializar(v) for v in linha) for linha in item]
                try:
                    cur.executemany(sql, valores)
                except Exception:
                    if rapido:
                        # Fallback seguro: desfaz o lote e tenta sem fast_executemany.
                        conn.rollback()
                        cur.fast_executemany = False
                        rapido = False
                        cur.executemany(sql, valores)
                    else:
                        raise
                total += len(valores)
                conn.commit()
                if context is not None and total % 20000 == 0:
                    context.log.info(f"Inseridas {total} linha(s) em {destino}.")
    conn.commit()
    return total


def _copiar_clickhouse(conn, destino: str, fila, context=None) -> int:
    """Grava os lotes no ClickHouse com o INSERT nativo do client HTTP."""
    primeiro = fila.get()
    if isinstance(primeiro, Exception):
        raise primeiro
    colunas = list(primeiro)
    if not colunas:
        return 0
    tabela = destino.replace("`", "")
    total = 0
    while True:
        item = fila.get()
        if item is _FIM:
            break
        if isinstance(item, Exception):
            raise item
        linhas = [tuple(_serializar(v) for v in linha) for linha in item]
        if linhas:
            conn._client.insert(tabela, linhas, column_names=colunas)
            total += len(linhas)
            if context is not None and total % 20000 == 0:
                context.log.info(f"Inseridas {total} linha(s) em {destino}.")
    return total


def _copiar_delta(conn, destino: str, fila, context=None) -> int:
    """Grava os lotes no Delta Lake com write_deltalake (mode=append)."""
    import pyarrow as pa
    from deltalake import write_deltalake

    primeiro = fila.get()
    if isinstance(primeiro, Exception):
        raise primeiro
    colunas = list(primeiro)
    if not colunas:
        return 0
    caminho = f"{conn.base}/{destino}"
    opcoes = conn.storage_options or None
    total = 0
    while True:
        item = fila.get()
        if item is _FIM:
            break
        if isinstance(item, Exception):
            raise item
        linhas = [tuple(_serializar(v) for v in linha) for linha in item]
        if linhas:
            tabela = pa.Table.from_pylist([dict(zip(colunas, linha)) for linha in linhas])
            write_deltalake(caminho, tabela, mode="append", storage_options=opcoes)
            total += len(linhas)
            if context is not None and total % 20000 == 0:
                context.log.info(f"Inseridas {total} linha(s) em {destino}.")
    return total


def carregar_tabela(tabela: Dict[str, Any], context=None) -> int:
    """Executa a carga de uma tabela seguindo as chaves de ``schedule`` do schema."""
    env = ler_env()
    tipo_origem = env["DB_ORIGEM_TYPE"]
    tipo_destino = env["DB_DESTINO_TYPE"]
    nome = tabela["table"]
    schema_origem = env.get("DB_ORIGEM_SCHEMA") or "public"
    schema_destino = tabela.get("schema") or env.get("DB_DESTINO_SCHEMA") or "public"

    schedule = tabela.get("schedule") or {}
    modo = schedule.get("mode", "full")
    coluna_inc = schedule.get("incremental_column")
    truncar = bool(schedule.get("truncate", False))
    forcar_full = bool(schedule.get("full_load", False))

    origem = _qualificado(tipo_origem, schema_origem, nome)
    destino = _qualificado(tipo_destino, schema_destino, nome)

    conn_origem = conectar(
        tipo_origem,
        env["DB_ORIGEM_HOST"], env["DB_ORIGEM_PORT"], env["DB_ORIGEM_NAME"],
        env["DB_ORIGEM_USER"], env["DB_ORIGEM_PASSWORD"],
    )
    conn_destino = conectar(
        tipo_destino,
        env["DB_DESTINO_HOST"], env["DB_DESTINO_PORT"], env["DB_DESTINO_NAME"],
        env["DB_DESTINO_USER"], env["DB_DESTINO_PASSWORD"],
    )
    if tipo_destino == "postgresql":
        _ajustar_statement_timeout(
            conn_destino,
            env.get("DB_DESTINO_STATEMENT_TIMEOUT", "0"),
            context,
        )
    try:
        colunas = _colunas_origem(conn_origem, tipo_origem, origem)
        if not colunas:
            return 0

        if truncar or modo == "full" or forcar_full:
            _truncar(conn_destino, tipo_destino, destino)

        cols_select = ", ".join(_aspas(tipo_origem, c) for c in colunas)

        if forcar_full or modo == "full" or not coluna_inc:
            sql = f"SELECT {cols_select} FROM {origem}"
            params = None
        else:
            watermark = _ultimo_valor(conn_destino, tipo_destino, destino, coluna_inc)
            if watermark is None:
                sql = f"SELECT {cols_select} FROM {origem}"
                params = None
            else:
                ph = _placeholder(tipo_origem)
                sql = (
                    f"SELECT {cols_select} FROM {origem} "
                    f"WHERE {_aspas(tipo_origem, coluna_inc)} > {ph} "
                    f"ORDER BY {_aspas(tipo_origem, coluna_inc)}"
                )
                params = [watermark]

        inicio = time.monotonic()
        fila = queue.Queue(maxsize=8)
        if tipo_origem == "deltalake":
            alvo_produtor = _produtor_delta
            args_produtor = (conn_origem, nome, fila)
        else:
            alvo_produtor = _produtor
            args_produtor = (conn_origem, sql, params, fila)
        thread = threading.Thread(
            target=alvo_produtor,
            args=args_produtor,
            daemon=True,
        )
        thread.start()
        try:
            inseridos = _copiar(conn_destino, tipo_destino, destino, fila, context)
        finally:
            while True:
                try:
                    fila.get_nowait()
                except queue.Empty:
                    break
            thread.join(timeout=30)

        if context is not None:
            tipo_carga = "full" if (forcar_full or modo == "full" or not coluna_inc) else "incremental"
            context.log.info(
                f"Tabela {nome}: {inseridos} linha(s) carregada(s) ({tipo_carga}) "
                f"em {time.monotonic() - inicio:.1f}s."
            )
        return inseridos
    finally:
        conn_origem.close()
        conn_destino.close()
