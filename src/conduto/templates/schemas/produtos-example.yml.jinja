table: produtos
schema: public
description: "Tabela de catálogo de produtos"
schedule:
  cron: "0 * * * *"
  mode: full
  full_load: false
  truncate: false
columns:
  - name: id
    type: integer
    primary_key: true
    nullable: false
  - name: sku
    type: varchar(50)
    unique: true
    nullable: false
  - name: nome
    type: varchar(255)
    nullable: false
  - name: preco_unitario
    type: numeric(12, 2)
    nullable: false
  - name: categoria
    type: varchar(100)
    nullable: true
  - name: ativo
    type: boolean
    default: true
